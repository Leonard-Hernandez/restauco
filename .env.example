# Copy to .env and fill in. Never commit .env.

# Public origin of the gateway (http://localhost:8091 locally, the tunnel/ingress URL in a demo)
PUBLIC_URL=http://localhost:8091
GATEWAY_PORT=8091

# Role of the restauco database in the shared Postgres (../platform)
USER_DB=restauco
PASSWORD_DB=change-me
# authco (MASTER_KEY, Google client) is configured in ../platform/.env

# Google email of the restaurant owner (first panel access)
BOOTSTRAP_OWNER_EMAIL=
